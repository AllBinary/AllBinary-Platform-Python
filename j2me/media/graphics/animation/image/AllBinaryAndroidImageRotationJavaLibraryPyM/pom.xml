                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${python.executable}</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>-u</argument>
                                <argument>${project.basedir}/build.py</argument>
                                <argument>${project.basedir}/src/main/java</argument>
                                <argument>${project.build.outputDirectory}/META-INF/python</argument>
                                <argument>${python.import.check}</argument>
                                <argument>${python.fail.on.error}</argument>
                                <argument>${python.jsinterop.source.path}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>


